# azd and Azure inputs
AZURE_ENV_NAME=visionsearch-dev
AZURE_LOCATION=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Capability gate
VISION_SEARCH_ENDPOINT=
VISION_SEARCH_API_VERSION=
VISION_ENDPOINT=
VISION_MODEL_VERSION=2023-04-15
VISION_VECTOR_DIMENSIONS=1024

# Vision-capable chat model for indexing-time verbalization and query-time explainability
AZURE_AISERVICES_ENDPOINT=
AZURE_AISERVICES_CHAT_DEPLOYMENT=gpt-4o
AZURE_AISERVICES_CHAT_MODEL_VERSION=2024-11-20

# Query feature flags (Function app settings; disabled defaults preserve vector-only search)
HYBRID_TEXT_ENABLED=false
SEMANTIC_RANKING_ENABLED=false
QUERY_IMAGE_ENRICHMENT_ENABLED=false
TEXT_QUERY_MAX_LENGTH=500

# Application endpoints, populated after deployment
VISION_API_BASE_URL=
VISION_INTERNAL_SITE_URL=
VISION_PUBLIC_SITE_URL=

# Load testing runtime values; never commit credentials or SAS URLs
LOADTEST_TARGET_MODE=api
LOADTEST_USER_COUNT=1
LOADTEST_SPAWN_RATE=1
LOADTEST_DURATION=60s
